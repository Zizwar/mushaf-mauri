# Mushaf MA Lite server — configuration
#
# These are PLAIN environment variables (the server does NOT load a .env file;
# there is no dotenv dependency). Set them in your shell, systemd unit, pm2
# ecosystem file, or Docker environment, e.g.:
#
#   PORT=4000 BASE_URL=https://recite.example.com npm start

# Port the HTTP server listens on.
# Default: 4000
PORT=4000

# Public base URL used to build shareUrl / audioUrl in API responses and on
# the share page. Set this to your public address behind a reverse proxy.
# Default: http://localhost:${PORT}
BASE_URL=http://localhost:4000

# Maximum upload size in megabytes (audio file).
# Default: 50
MAX_UPLOAD_MB=50

# Directory for metadata (recitations.json). Created on boot if missing.
# Default: ./data (relative to the server folder)
DATA_DIR=./data

# Directory for uploaded audio files ({id}.m4a). Created on boot if missing.
# Default: ./uploads (relative to the server folder)
UPLOADS_DIR=./uploads
